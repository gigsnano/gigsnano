# Copy to .env.local for `pnpm dev`. NEXT_PUBLIC_* values are inlined at build time.

# Where the browser sends API calls. Either the API directly (dev) or "/api" to go
# through this app's same-origin proxy (needs API_PROXY_TARGET; used by docker compose).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8020/api
# Server-side proxy target for /api/*, /mcp and /oauth (backend API base URL).
API_PROXY_TARGET=http://localhost:8020/api

# true = serve everything from in-app fixtures (no backend needed). false = real API.
NEXT_PUBLIC_USE_MOCKS=false

# Google sign-in (must equal the backend GOOGLE_CLIENT_ID). Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional feature flags
# NEXT_PUBLIC_JOURNEY=true
# NEXT_PUBLIC_WORK_ITEM_V2=true
# NEXT_PUBLIC_GANTT_DHTMLX=true
# NEXT_PUBLIC_SOLUTIONS=false
# NEXT_PUBLIC_CODEBASE_OVERVIEW_V2=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
