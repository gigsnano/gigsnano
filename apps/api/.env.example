# Postgres. Default matches the root docker-compose `db` service published on host port 5433.
# Any Postgres 16 works; managed hosts usually need `?ssl=require`.
DATABASE_URL=postgresql+asyncpg://gigsnano:gigsnano@localhost:5433/gigsnano

JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

# Google OAuth (OAuth 2.0 Web client ID from your Google Cloud project).
# Must match frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Empty ⇒ POST /auth/google/ returns 503.
# GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Hosted-service billing: workspace wallet + AI charging. Leave false when self-hosting.
# BILLING_ENABLED=false

# Billing / payments (Stripe). Empty STRIPE_SECRET_KEY ⇒ FakePaymentProvider (keyless dev).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_API_VERSION=2026-05-27.dahlia
# APP_BASE_URL=http://localhost:3000
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/marketplace/profile
# STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/marketplace/profile

# Email (Azure Communication Services). Empty ACS_CONNECTION_STRING ⇒ FakeEmailProvider.
# ACS_CONNECTION_STRING=endpoint=https://...
# EMAIL_FROM=DoNotReply@your-verified-domain.com
# EMAIL_REPLY_TO=support@your-domain.com
# APP_BASE_URL=http://localhost:3000

# Hosted MCP / OAuth (empty PUBLIC_BASE_URL ⇒ request Host header is used for discovery)
# When the Next.js frontend proxies /mcp and /oauth on app.gigsnano.com, set:
#   PUBLIC_BASE_URL=https://mcp.gigsnano.com   (optional legacy MCP host)
#   FRONTEND_URL=https://app.gigsnano.com      (required — browser OAuth + session cookies)
# Or unify both on the frontend origin:
#   PUBLIC_BASE_URL=https://app.gigsnano.com
#   FRONTEND_URL=https://app.gigsnano.com
# MCP_TOKEN_TTL_MINUTES=60
