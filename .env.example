# Optional overrides for docker-compose.yml. Copy to .env next to this file.

# Change before exposing the instance: signs session tokens.
JWT_SECRET=dev-secret-change-me
# Public origin of the web app (used for CORS, links in emails, OAuth redirects).
WEB_ORIGIN=http://localhost:3000
# Set true when serving over HTTPS.
COOKIE_SECURE=false
# Google sign-in client ID (also set GOOGLE_CLIENT_ID in apps/api/.env). Build-time.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Hosted-service billing (workspace wallet). Leave false when self-hosting.
BILLING_ENABLED=false
